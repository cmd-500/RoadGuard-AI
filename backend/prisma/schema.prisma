datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  GOVT
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(USER)
  reputation     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reports        Report[]
  verifications  ReportVerification[]
}

model Report {
  id             String       @id @default(uuid())
  userId         String
  latitude       Float
  longitude      Float
  imageUrl       String?
  description    String?
  status         ReportStatus @default(PENDING)

  // AI Service Data
  aiConfidence   Float?
  aiDetectedType String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id])
  verifications  ReportVerification[]

  // Indexes to optimize geospatial lookups and dashboard filters
  @@index([latitude, longitude])
  @@index([status])
}

model ReportVerification {
  id         String   @id @default(uuid())
  reportId   String
  userId     String
  isUpvote   Boolean
  createdAt  DateTime @default(now())

  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents a user from voting multiple times on the same report
  @@unique([reportId, userId])
}