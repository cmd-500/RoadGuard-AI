# -----------------------------------------------------------------------------
# Maven Wrapper
# -----------------------------------------------------------------------------

# OS specific support.  $var _must_ be set to either true or false.
cygwin=false
mingw=false
darwin=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true ;;
  Darwin*) darwin=true ;;
esac

# resolve links - $0 may be a softlink
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG="$(dirname "$PRG")/$link"
  fi
done

PRGDIR=$(dirname "$PRG")
BASEDIR=$(cd "$PRGDIR" > /dev/null && pwd)

# -----------------------------------------------------------------------------
# Helper functions
# -----------------------------------------------------------------------------

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

warn() {
  echo "WARN: $*" >&2
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

# Determine the java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
  if [ ! -x "$JAVACMD" ] ; then
    fail "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
  fi
else
  JAVACMD="java"
  which java >/dev/null 2>&1 || fail "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$darwin" = "false" ] ; then
  MAX_FD_LIMIT=$(ulimit -H -n)
  if [ $? -eq 0 ] ; then
    if [ "$MAX_FD_LIMIT" = "unlimited" -o $MAX_FD_LIMIT -ge 4096 ] ; then
      ulimit -n 4096
    fi
  fi
fi

# For Cygwin, switch paths to Windows format before running java
if [ "$cygwin" = "true" ] ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cygpath --path --windows "$JAVA_HOME")
  [ -n "$CLASSPATH" ] && CLASSPATH=$(cygpath --path --windows "$CLASSPATH")
  BASEDIR=$(cygpath --path --windows "$BASEDIR")
fi

# For MinGW, switch paths to Windows format before running java
if [ "$mingw" = "true" ] ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cmd //c echo %JAVA_HOME%)
  [ -n "$CLASSPATH" ] && CLASSPATH=$(cmd //c echo %CLASSPATH%)
  BASEDIR=$(cmd //c echo %BASEDIR%)
fi

# Locate the wrapper jar
WRAPPER_JAR="$BASEDIR/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ] ; then
  fail "ERROR: $WRAPPER_JAR not found. Run 'mvn wrapper:wrapper' to generate it."
fi

# Execute the wrapper
exec "$JAVACMD" \
  -Dmaven.multiModuleProjectDirectory="$BASEDIR" \
  -jar "$WRAPPER_JAR" \
  "$@"